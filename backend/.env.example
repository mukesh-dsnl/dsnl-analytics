# ── Database ──
# MySQL connection URL (required)
DATABASE_URL=mysql+pymysql://root:REMOVED_PASSWORD@localhost:3306/analytics
# Required for Multicall Registration Lookup. Use a SELECT-only account for source tables.
MULTICALL_DATABASE_URL=mysql+pymysql://user:password@localhost:3306/multicall

# ── CDR analytics: parquet lake (read in place, nothing is uploaded) ──
# Directories of daily parquet exports (opened based on dashboard date range)
CDR_LAKE_PATH=
CODR_LAKE_PATH=

# Max date range for a single query to prevent reading too many files
CDR_MAX_RANGE_DAYS=31

# ── AI chat (optional) ──
# Optional AI settings. Provider auto-detects based on available API key.
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_MAX_RANGE_DAYS=31
AI_MAX_ROWS_TO_MODEL=500
AI_MAX_TOOL_ROUNDS=5

# Only the key for the provider in use is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Failover pool: when backend/ai_pool.json exists it replaces AI_PROVIDER /
# AI_MODEL, and each listed key is tried with each of its models in order.
# The JSON names the variable holding each key (key_env); put the keys here.
# Entries whose variable is empty are skipped.
GOOGLE_API_KEY_2=
AI_POOL_FILE=ai_pool.json
AI_ATTEMPT_TIMEOUT_SECONDS=30
AI_FAILOVER_BUDGET_SECONDS=90

# Price per million tokens for chat cost estimation (set real rates for accuracy)
AI_PRICE_INPUT_PER_MTOK=0.30
AI_PRICE_OUTPUT_PER_MTOK=2.50
AI_PRICE_CURRENCY=USD

# ── Sessions ──────────────────────────────────────────
# Login session lifetime in days (affects new logins only)
SESSION_TTL_DAYS=7
SESSION_COOKIE_NAME=dsnl_session
# Set to true when served over TLS (must be false for plain http)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
