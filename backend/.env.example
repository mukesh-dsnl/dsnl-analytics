# ── Database ──────────────────────────────────────────
# MySQL connection URL (required)
DATABASE_URL=mysql+pymysql://root:abcd1234@localhost:3306/analytics

# ── CDR analytics: parquet lake (read in place, nothing is uploaded) ──
# Directories of daily exports named cdr_YYYYMMDD.parquet / codr_YYYYMMDD.parquet.
# The dashboard's date range decides which of these files are opened.
CDR_LAKE_PATH=
CODR_LAKE_PATH=

# Largest date range a single query may span. The lake is a network share, so
# this is what stops one request reading a year of files.
CDR_MAX_RANGE_DAYS=31

# ── AI chat (optional) ────────────────────────────────────────────────
# Everything below may be left unset. With no key configured the dashboards
# work exactly as before and only POST /api/ai/chat fails, with a 503 naming
# the variable to set.
#
# Which provider to use. Unset = auto-detect: the first key present wins, in
# the order ANTHROPIC_API_KEY, OPENAI_API_KEY, GOOGLE_API_KEY.
AI_PROVIDER=gemini
# Provider-specific model id. Unset = that provider's own default.
AI_MODEL=gemini-3.5-flash-lite

# Tighter than CDR_MAX_RANGE_DAYS: an ad-hoc range is picked by a model that
# can't see what a wide one costs, and it can pick a new one every round.
AI_MAX_RANGE_DAYS=7
# Result rows allowed back into the model's context, applied as a structural
# LIMIT the generated SQL cannot widen.
AI_MAX_ROWS_TO_MODEL=500
# Tool-calling rounds per question before the loop gives up.
AI_MAX_TOOL_ROUNDS=5

# Only the key for the provider in use is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# LLM api key
API_KEY=